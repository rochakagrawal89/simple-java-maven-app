pipeline {
    agent {
        label 'ubuntu'  // Correct way to specify a specific node/label
    }

    tools {
        // This must match the name in Global Tool Configuration
        maven 'maven-3.9.9' 
    }

    stages {
        stage('Build') {
            steps {
                // Good practice to use -B (batch mode) for CI logs
                sh 'mvn -B -DskipTests clean package'
            }
        }
    }
}
